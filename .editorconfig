# Java layout used by this project (RuneLite style). IntelliJ reads the ij_ keys,
# so Code > Reformat Code (Ctrl+Alt+L) keeps braces on their own lines.
root = true

[*.java]
charset = utf-8
indent_style = tab
indent_size = 4
tab_width = 4
ij_continuation_indent_size = 8
max_line_length = 160
insert_final_newline = true
trim_trailing_whitespace = true
ij_java_class_brace_style = next_line
ij_java_method_brace_style = next_line
ij_java_brace_style = next_line
ij_java_lambda_brace_style = next_line
ij_java_else_on_new_line = true
ij_java_catch_on_new_line = true
ij_java_finally_on_new_line = true
ij_java_while_on_new_line = true
ij_java_keep_simple_methods_in_one_line = true
ij_java_keep_simple_classes_in_one_line = true
ij_java_space_after_type_cast = true
ij_java_indent_case_from_switch = true
ij_java_keep_blank_lines_in_code = 1
ij_java_keep_blank_lines_in_declarations = 1
ij_java_keep_blank_lines_before_right_brace = 0
